# ========== APPLICATION ==========
SECRET_KEY=generate-with-python-c-import-secrets-secrets-token_hex-32
APP_HOST=0.0.0.0
APP_PORT=5000
FLASK_ENV=production

# ========== DATABASE (Railway MySQL) ==========
# Railway otomatis generate ini di panel
DB_HOST=railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_railway_db_password
DB_NAME=monitoring_review

# ========== EXTERNAL APIs ==========
# SerpAPI untuk Google Maps Scraping
SERPAPI_KEY=your_serpapi_key_here

# Telegram Bot Token (untuk notifikasi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========== RUNTIME SETTINGS ==========
MIN_SCRAPE_INTERVAL_SEC=30
DATA_DIR=/tmp

# ========== LOGGING (Optional) ==========
LOG_LEVEL=INFO
